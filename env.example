# پورت اجرای سرور
PORT=3000

# آدرس سامانه گلستان دانشگاه خودت (بدون اسلش آخر)
GOLESTAN_URL=https://golestan.YOUR-UNIVERSITY.ac.ir

# کلید رمزنگاری رمزهای عبور — دقیقا 64 کاراکتر هگز (32 بایت)
# برای ساختنش می‌تونی این دستور رو در ترمینال اجرا کنی:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# مسیر اجرایی مرورگر کروم روی سیستم خودت (برای puppeteer-core)
# ویندوز مثال:  C:\Program Files\Google\Chrome\Application\chrome.exe
# مک مثال:      /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# لینوکس مثال:  /usr/bin/google-chrome
CHROME_EXECUTABLE_PATH=

# هر چند دقیقه یک‌بار به‌صورت خودکار نمرات چک بشه
CHECK_INTERVAL_MINUTES=30

# برای نوتیفیکیشن از طریق ربات تلگرام (ساده‌ترین روش)
# ربات رو با @BotFather بساز و توکن رو اینجا بذار
TELEGRAM_BOT_TOKEN=
